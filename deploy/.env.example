# Production settings for ~/norbiz/.env on the deploy server (bootstrap.sh creates it from this file
# and fills in random DB_PASSWORD / JWT_SECRET). Keep it chmod 600 and never commit it.
# Values are read by both docker compose and deploy.sh (sourced by bash) — no spaces around '=',
# quote values that contain spaces or shell characters.

# --- Server ---
# Hostname/IP browsers use to reach the server — must match the certificate in ~/norbiz/certs.
# CORS must allow it (https://<host>, plus :port if WEB_HTTPS_PORT != 443).
PUBLIC_HOST=10.18.18.18
CORS_ALLOWED_ORIGINS=https://10.18.18.18
# WEB_PORT only redirects to HTTPS. APP_PORT is plain-HTTP direct API access on the server's localhost.
WEB_PORT=80
WEB_HTTPS_PORT=443
APP_PORT=8080

# --- Database (only applied when the postgres volume is first created) ---
DB_USERNAME=norbiz
DB_PASSWORD=__generated__

# Postgres is published on DB_BIND:DB_PORT. Use 127.0.0.1 to close it to other machines.
DB_BIND=0.0.0.0
DB_PORT=5432

# --- Auth --- base64 HS256 key: head -c 48 /dev/urandom | base64 -w0
JWT_SECRET=__generated__
JWT_EXPIRATION=43200000

# --- App ---
APP_MAX_HEAP=768m
# CPU threads for the CLIP embedder (default 2 in docker-compose.prod.yml); 4 on the 16-vCPU prod VM.
#EMBEDDER_THREADS=4
DEPLOYMENT_ENVIRONMENT=prod

# --- Observability (opt-in, docs/DEPLOYMENT.md#operating) ---
# OTLP export of traces/logs/metrics to the lgtm container. Only set true once lgtm is running
# (`$C --profile observability up -d lgtm`) — otherwise the app logs export connection errors.
OTEL_EXPORT_ENABLED=false
# Trace head sampling and JDBC span types (defaults in docker-compose.prod.yml: 0.1 / CONNECTION).
# Raise to 1.0 / CONNECTION,QUERY temporarily to debug — see docs/OBSERVABILITY.md#production-sampling.
#TRACING_SAMPLING_PROBABILITY=0.1
#JDBC_SPAN_INCLUDES=CONNECTION

# --- Source (deploy.sh) ---
# Host aliases map to per-repo deploy keys in ~/norbiz/ssh/config. For public repos you can use
# https://github.com/<owner>/<repo>.git instead and skip the deploy keys.
NORBIZ_REPO=git@github-norbiz:richarddonor/Norbiz.git
NORBIZ_WEB_REPO=git@github-norbiz-web:richarddonor/Norbiz-Web.git
NORBIZ_REF=master
NORBIZ_WEB_REF=master

# How many pre-release database backups to keep in ~/norbiz/backups
BACKUP_KEEP=10
