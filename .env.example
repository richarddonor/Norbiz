# Database credentials (used by the db + app services in docker-compose.yml)
DB_USERNAME=norbiz
DB_PASSWORD=changeme

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/norbiz
SPRING_DATASOURCE_USERNAME=norbiz
SPRING_DATASOURCE_PASSWORD=changeme
SPRING_JPA_HIBERNATE_DDL_AUTO=update

JWT_SECRET=your-base64-encoded-secret-here
JWT_EXPIRATION=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend build-time API base URL (baked into the static build by Norbiz-Web's Dockerfile)
VITE_API_BASE=http://localhost:8080
