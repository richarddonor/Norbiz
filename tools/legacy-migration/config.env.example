# Copy to config.env (git-ignored), fill in, then load it:  set -a; . ./config.env; set +a
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_DATABASE=jbsKarutora
# Target Norbiz database. Rehearse against a scratch database (norbiz_mig) first.
PG_DSN=postgresql://norbiz:changeme@localhost:5432/norbiz_mig
# The Norbiz server's app.item-image.upload-dir (images.py writes item pictures here).
ITEM_IMAGE_UPLOAD_DIR=
# Backup: run_migration.sh uses pg_dump if installed, else `docker exec $PG_DOCKER_CONTAINER pg_dump`.
PG_DOCKER_CONTAINER=
# The Redis the app uses (its query cache is flushed after the load).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
