# Copy to config.env (git-ignored), fill in, then load it:  set -a; . ./config.env; set +a
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=dDeletedelete1!
MSSQL_DATABASE=jbsKarutora
# Target Norbiz database. Rehearse against a scratch database (norbiz_mig) first.
PG_DSN=postgresql://norbiz:changeme@localhost:5432/norbiz
# Item pictures (images.py). Norbiz on this machine: ITEM_IMAGE_UPLOAD_DIR = its app.item-image.upload-dir.
# Norbiz on another server: ITEM_IMAGE_REMOTE = <ssh user@host>:<Docker volume mounted at its upload dir>
# (prod: norbiz_item_images); pictures stream over SSH straight into it and it wins over the dir.
ITEM_IMAGE_UPLOAD_DIR=/Users/rdonor/norbiz
ITEM_IMAGE_REMOTE=
# Backup: run_migration.sh uses pg_dump if installed; else `docker exec $PG_DOCKER_CONTAINER pg_dump` when
# PG_DSN is localhost, otherwise a throwaway `docker run postgres:17-alpine pg_dump` against PG_DSN.
PG_DOCKER_CONTAINER=norbiz-db-1
# The Redis the app uses (its query cache is flushed after the load).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
